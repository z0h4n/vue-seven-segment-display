{
  "name": "vue-seven-segment-display",
  "version": "3.0.0",
  "description": "A Seven Segment Display Component for Vue.js",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsdown",
    "images": "npm run build && node scripts/generate-images.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/z0h4n/vue-seven-segment-display.git"
  },
  "keywords": [
    "vue",
    "vue-component",
    "vue component",
    "seven",
    "segment",
    "7segment",
    "7-segment",
    "7 segment",
    "sevensegment",
    "seven-segment",
    "seven segment",
    "component"
  ],
  "author": "z0h4n",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/z0h4n/vue-seven-segment-display/issues"
  },
  "homepage": "https://github.com/z0h4n/vue-seven-segment-display#readme",
  "peerDependencies": {
    "vue": ">=3.3"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.2",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vue": "^3.5.43"
  }
}
